{
  "name": "scheduler-card-trvzb",
  "version": "0.1.0",
  "description": "Sonoff TRVZB internal schedule editor for Home Assistant",
  "main": "dist/scheduler-card-TRVZB.js",
  "scripts": {
    "build": "npm run check && npm run lint && npm run format:check && npm run rollup",
    "rollup": "rollup -c",
    "lint": "eslint src/trvzb/**/*.ts src/trvzb-internal-scheduler-card.ts test/**/*.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src/trvzb src/trvzb-internal-scheduler-card.ts test vitest.config.ts README.md package.json hacs.json .github/workflows/ci.yml .github/workflows/release.yml",
    "format:check": "prettier --check src/trvzb src/trvzb-internal-scheduler-card.ts test vitest.config.ts README.md package.json hacs.json .github/workflows/ci.yml .github/workflows/release.yml",
    "test": "vitest run",
    "start": "rollup -c --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgooGG/scheduler-card-TRVZB.git"
  },
  "author": "IgooGG and contributors",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/IgooGG/scheduler-card-TRVZB/issues"
  },
  "homepage": "https://github.com/IgooGG/scheduler-card-TRVZB#readme",
  "dependencies": {
    "@formatjs/intl-utils": "^3.8.4",
    "@mdi/js": "^7.4.47",
    "fecha": "^4.2.3",
    "home-assistant-js-websocket": "^8.0.1",
    "lit": "^2.7.4",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@parcel/transformer-inline-string": "^2.8.3",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-dynamic-import-vars": "^2.1.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "parcel": "^2.8.3",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "vitest": "^3.2.4"
  }
}
